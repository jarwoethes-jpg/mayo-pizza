# Public HTTP and canonical hostnames
HOST=0.0.0.0
PORT=3000
PUBLIC_HOSTNAME=mayo.pizza
WEB_ROOT=/app/web-dist
ROOM_STATE_PATH=/app/state/rooms.json
NODE_ENV=production

# Only these proxy source addresses may supply X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# TURN/coturn shared secret. Set this in Portainer; never commit the real value.
TURN_STATIC_SECRET=
# Bearer token guarding /metrics. Required; compose refuses to start without it.
METRICS_TOKEN=
STUN_HOST=mayo.pizza
TURN_HOST=mayo.pizza
STUN_PORT=3478
TURN_PORT=3478
TURNS_HOST=turn.mayo.pizza
TURNS_PORT=443

# Required for the Umami and Postgres services.
UMAMI_DB_PASSWORD=
UMAMI_HASH_SALT=
